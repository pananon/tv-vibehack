<?xml version="1.0" encoding="utf-8"?>
<!-- Claude on TV: the live Claude Code chat from the PC (view only). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="28dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/claudeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#F2FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />

            <View
                android:id="@+id/claudeDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/claudeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#1FFFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/claudeList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:focusable="false"
            android:descendantFocusability="blocksDescendants"
            android:scrollbars="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/claude_hint"
            android:textColor="#66FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.06" />
    </LinearLayout>
</FrameLayout>
