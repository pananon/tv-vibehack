<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for the Ambient tile: a soft colour sweep with the ambient mark in the middle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:type="linear" android:angle="315"
                android:startColor="#FF1B3FAF" android:centerColor="#FF7A2FB8" android:endColor="#FFD9653B" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_ambient" android:gravity="center"
        android:width="96dp" android:height="96dp" />
</layer-list>
