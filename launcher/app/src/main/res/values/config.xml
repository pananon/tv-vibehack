<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Starting dock order. Edit the dock on the TV afterwards: press Menu (or hold OK) on a tile.
         Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.heytap.tv.livetv</item>
        <item>com.oneplus.tv.screensaver</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.heytap.tv.livetv</string>

    <!-- Weather next to the clock, from open-meteo.com (free, no account). Leave both empty to turn it
         off: the launcher then never uses the network. Basti, Uttar Pradesh. -->
    <string name="weather_latitude" translatable="false">26.79</string>
    <string name="weather_longitude" translatable="false">82.72</string>
    <!-- celsius or fahrenheit -->
    <string name="weather_unit" translatable="false">celsius</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>
</resources>
